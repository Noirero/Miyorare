{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miyorare-drive-auth",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_STORE",
        "class_name": "OAuthStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OAuthStore"]
    }
  ]
}
