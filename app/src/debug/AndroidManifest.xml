<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds keep installer capability for local APK/update testing. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <activity
            android:name="org.koitharu.kotatsu.main.ui.MainActivity"
            android:theme="@style/Theme.Miyorare.Splash" />
        <activity
            android:name="org.koitharu.kotatsu.sync.ui.BrowserDriveAuthCallbackActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.Kotatsu.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="miyorare" android:host="google-drive-auth" />
            </intent-filter>
        </activity>
    </application>

</manifest>
