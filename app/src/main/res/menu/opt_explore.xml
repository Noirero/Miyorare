<?xml version="1.0" encoding="utf-8"?>
<menu
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto">

	<item
		android:id="@+id/action_source_search"
		android:icon="@drawable/ic_search"
		android:title="@string/search_extensions"
		app:actionViewClass="androidx.appcompat.widget.SearchView"
		app:showAsAction="ifRoom|collapseActionView" />

	<!-- This controls whether NSFW sources may appear at all; the visible header buttons below remain
	     the actual All / SFW / NSFW content filter. -->
	<item
		android:id="@+id/action_show_nsfw_sources"
		android:checkable="true"
		android:title="@string/show_nsfw_sources" />

	<item
		android:id="@+id/action_content_classification_reset_all"
		android:title="@string/explore_content_reset_all" />

	<group
		android:id="@+id/group_source_view"
		android:checkableBehavior="single">
		<item
			android:id="@+id/action_source_view_modern"
			android:checkable="true"
			android:title="@string/explore_view_modern" />
		<item
			android:id="@+id/action_source_view_list"
			android:checkable="true"
			android:title="@string/explore_view_list" />
	</group>

	<item
		android:id="@+id/action_source_filter"
		android:icon="@drawable/ic_filter_funnel"
		android:title="@string/source_filter"
		app:showAsAction="ifRoom" />

	<!-- Extension management intentionally has one visible entry point in Explore: the Extensions
	     button beside the Sources selector. Do not add a second catalog shortcut here. -->

</menu>
