<?xml version="1.0" encoding="utf-8"?>
<!-- Explore's header: quick actions/suggestions, a persistent Modern/List source-view selector,
     content filtering, and the manga/novel selector. Extension management has one canonical
     destination: the Extensions button opens the existing extension catalog/management flow. -->
<org.koitharu.kotatsu.explore.ui.MiyorareExploreHeaderLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/layout_explore_header"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?android:attr/colorBackground"
	android:orientation="vertical">

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/recyclerView_header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:clipChildren="false"
		android:clipToPadding="false"
		android:nestedScrollingEnabled="false"
		android:orientation="vertical"
		tools:listitem="@layout/item_explore_buttons" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="16dp"
		android:layout_marginTop="4dp"
		android:layout_marginEnd="16dp"
		android:layout_marginBottom="2dp"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/miyorare_display_mode"
			android:textAppearance="?textAppearanceLabelLarge" />

		<com.google.android.material.button.MaterialButtonToggleGroup
			android:id="@+id/toggle_source_view"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:checkedButton="@id/button_source_view_modern"
			app:selectionRequired="true"
			app:singleSelection="true">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_source_view_modern"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:includeFontPadding="true"
				android:maxLines="1"
				android:minHeight="48dp"
				android:minWidth="76dp"
				android:paddingStart="14dp"
				android:paddingEnd="14dp"
				android:text="@string/explore_view_modern"
				android:textAllCaps="false"
				android:textAppearance="?textAppearanceLabelLarge" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_source_view_list"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:includeFontPadding="true"
				android:maxLines="1"
				android:minHeight="48dp"
				android:minWidth="72dp"
				android:paddingStart="14dp"
				android:paddingEnd="14dp"
				android:text="@string/explore_view_list"
				android:textAllCaps="false"
				android:textAppearance="?textAppearanceLabelLarge" />

		</com.google.android.material.button.MaterialButtonToggleGroup>

	</LinearLayout>

	<com.google.android.material.button.MaterialButtonToggleGroup
		android:id="@+id/toggle_content_filter"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="16dp"
		android:layout_marginTop="4dp"
		android:layout_marginEnd="16dp"
		android:layout_marginBottom="2dp"
		app:checkedButton="@id/button_content_filter_all"
		app:selectionRequired="true"
		app:singleSelection="true">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_content_filter_all"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:minHeight="44dp"
			android:text="@string/explore_content_filter_all"
			android:textAllCaps="false" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_content_filter_sfw"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:minHeight="44dp"
			android:text="@string/explore_content_sfw"
			android:textAllCaps="false" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_content_filter_nsfw"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:minHeight="44dp"
			android:text="@string/explore_content_nsfw"
			android:textAllCaps="false" />

	</com.google.android.material.button.MaterialButtonToggleGroup>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="@dimen/grid_spacing"
		android:paddingVertical="@dimen/grid_spacing">

		<FrameLayout
			android:layout_width="@dimen/explore_header_side_width"
			android:layout_height="48dp">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="start|center_vertical"
				android:ellipsize="end"
				android:singleLine="true"
				android:text="@string/explore_sources_label"
				android:textAppearance="?textAppearanceTitleSmall" />

		</FrameLayout>

		<FrameLayout
			android:layout_width="0dp"
			android:layout_height="48dp"
			android:layout_weight="1"
			android:background="@drawable/bg_explore_kind_rail">

			<com.google.android.material.tabs.TabLayout
				android:id="@+id/tabs_kind"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="@null"
				app:tabGravity="fill"
				app:tabIndicatorAnimationMode="elastic"
				app:tabIndicatorColor="?attr/colorPrimary"
				app:tabIndicatorFullWidth="false"
				app:tabIndicatorHeight="3dp"
				app:tabMode="fixed"
				app:tabRippleColor="@null"
				app:tabSelectedTextColor="?attr/colorPrimary"
				app:tabTextAppearance="?textAppearanceLabelLarge"
				app:tabTextColor="?attr/colorOnSurfaceVariant" />

			<View
				android:layout_width="1dp"
				android:layout_height="20dp"
				android:layout_gravity="center"
				android:background="?attr/colorOutlineVariant"
				android:importantForAccessibility="no" />

		</FrameLayout>

		<FrameLayout
			android:layout_width="@dimen/explore_header_side_width"
			android:layout_height="48dp">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_manage"
				style="@style/Widget.Kotatsu.Button.More.Small"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="end|center_vertical"
				android:minWidth="40dp"
				android:minHeight="32dp"
				android:text="@string/extensions"
				tools:text="@string/extensions" />

		</FrameLayout>

	</LinearLayout>

</org.koitharu.kotatsu.explore.ui.MiyorareExploreHeaderLayout>
