<?xml version="1.0" encoding="utf-8"?>
<!-- Explore controls: Manga / Novel / Extensions share one segmented rail. The persistent
     Modern/List mode and the All/SFW/NSFW filter stay visible directly below it. -->
<org.koitharu.kotatsu.explore.ui.MiyorareExploreHeaderLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/layout_explore_header"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?android:attr/colorBackground"
	android:orientation="vertical">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="48dp"
		android:layout_marginStart="16dp"
		android:layout_marginTop="4dp"
		android:layout_marginEnd="16dp"
		android:layout_marginBottom="4dp"
		android:background="@drawable/bg_explore_kind_rail"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<FrameLayout
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="2">

			<com.google.android.material.tabs.TabLayout
				android:id="@+id/tabs_kind"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="@null"
				app:tabGravity="fill"
				app:tabIndicatorAnimationMode="elastic"
				app:tabIndicatorColor="?attr/colorPrimary"
				app:tabIndicatorFullWidth="false"
				app:tabIndicatorHeight="3dp"
				app:tabMode="fixed"
				app:tabRippleColor="@null"
				app:tabSelectedTextColor="?attr/colorPrimary"
				app:tabTextAppearance="?textAppearanceLabelLarge"
				app:tabTextColor="?attr/colorOnSurfaceVariant" />

		</FrameLayout>

		<View
			android:layout_width="1dp"
			android:layout_height="22dp"
			android:background="?attr/colorOutlineVariant"
			android:importantForAccessibility="no" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_manage"
			style="@style/Widget.Kotatsu.Button.More.Small"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:insetLeft="0dp"
			android:insetTop="0dp"
			android:insetRight="0dp"
			android:insetBottom="0dp"
			android:minHeight="48dp"
			android:text="@string/extensions"
			android:textAllCaps="false"
			android:textSize="16sp"
			app:backgroundTint="@android:color/transparent"
			app:cornerRadius="0dp"
			app:strokeWidth="0dp"
			tools:text="@string/extensions" />

	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="16dp"
		android:layout_marginEnd="16dp"
		android:layout_marginBottom="4dp"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:ellipsize="end"
			android:singleLine="true"
			android:text="@string/miyorare_display_mode"
			android:textAppearance="?textAppearanceLabelLarge"
			android:textSize="16sp" />

		<com.google.android.material.button.MaterialButtonToggleGroup
			android:id="@+id/toggle_source_view"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:checkedButton="@id/button_source_view_modern"
			app:selectionRequired="true"
			app:singleSelection="true">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_source_view_modern"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="wrap_content"
				android:layout_height="44dp"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:minHeight="44dp"
				android:minWidth="76dp"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:text="@string/explore_view_modern"
				android:textAllCaps="false"
				android:textSize="16sp"
				android:textAppearance="?textAppearanceLabelLarge" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_source_view_list"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="wrap_content"
				android:layout_height="44dp"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:minHeight="44dp"
				android:minWidth="72dp"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:text="@string/explore_view_list"
				android:textAllCaps="false"
				android:textSize="16sp"
				android:textAppearance="?textAppearanceLabelLarge" />

		</com.google.android.material.button.MaterialButtonToggleGroup>

	</LinearLayout>

	<com.google.android.material.button.MaterialButtonToggleGroup
		android:id="@+id/toggle_content_filter"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="16dp"
		android:layout_marginEnd="16dp"
		android:layout_marginBottom="4dp"
		app:checkedButton="@id/button_content_filter_all"
		app:selectionRequired="true"
		app:singleSelection="true">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_content_filter_all"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="0dp"
			android:layout_height="44dp"
			android:layout_weight="1"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:minHeight="44dp"
			android:text="@string/explore_content_filter_all"
			android:textAllCaps="false"
			android:textSize="16sp" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_content_filter_sfw"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="0dp"
			android:layout_height="44dp"
			android:layout_weight="1"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:minHeight="44dp"
			android:text="@string/explore_content_sfw"
			android:textAllCaps="false"
			android:textSize="16sp" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_content_filter_nsfw"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="0dp"
			android:layout_height="44dp"
			android:layout_weight="1"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:minHeight="44dp"
			android:text="@string/explore_content_nsfw"
			android:textAllCaps="false"
			android:textSize="16sp" />

	</com.google.android.material.button.MaterialButtonToggleGroup>

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/recyclerView_header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:clipChildren="false"
		android:clipToPadding="false"
		android:nestedScrollingEnabled="false"
		android:orientation="vertical"
		tools:listitem="@layout/item_explore_buttons" />

</org.koitharu.kotatsu.explore.ui.MiyorareExploreHeaderLayout>
