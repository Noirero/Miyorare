<?xml version="1.0" encoding="utf-8"?>
<!-- Compact Explore controls. The source-view mode remains available from Explore's overflow menu,
     while Manga / Novel / Extensions and SFW controls stay immediately visible. -->
<org.koitharu.kotatsu.explore.ui.MiyorareExploreHeaderLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/layout_explore_header"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?android:attr/colorBackground"
	android:orientation="vertical">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="44dp"
		android:layout_marginStart="16dp"
		android:layout_marginTop="4dp"
		android:layout_marginEnd="16dp"
		android:layout_marginBottom="4dp"
		android:background="@drawable/bg_explore_kind_rail"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<FrameLayout
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="2">

			<com.google.android.material.tabs.TabLayout
				android:id="@+id/tabs_kind"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="@null"
				app:tabGravity="fill"
				app:tabIndicatorAnimationMode="elastic"
				app:tabIndicatorColor="?attr/colorPrimary"
				app:tabIndicatorFullWidth="false"
				app:tabIndicatorHeight="3dp"
				app:tabMode="fixed"
				app:tabRippleColor="@null"
				app:tabSelectedTextColor="?attr/colorPrimary"
				app:tabTextAppearance="?textAppearanceLabelLarge"
				app:tabTextColor="?attr/colorOnSurfaceVariant" />

		</FrameLayout>

		<View
			android:layout_width="1dp"
			android:layout_height="20dp"
			android:background="?attr/colorOutlineVariant"
			android:importantForAccessibility="no" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_manage"
			style="@style/Widget.Kotatsu.Button.More.Small"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:minHeight="40dp"
			android:text="@string/extensions"
			android:textAllCaps="false"
			tools:text="@string/extensions" />

	</LinearLayout>

	<com.google.android.material.button.MaterialButtonToggleGroup
		android:id="@+id/toggle_content_filter"
		android:layout_width="match_parent"
		android:layout_height="40dp"
		android:layout_marginStart="16dp"
		android:layout_marginEnd="16dp"
		android:layout_marginBottom="4dp"
		app:checkedButton="@id/button_content_filter_all"
		app:selectionRequired="true"
		app:singleSelection="true">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_content_filter_all"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:minHeight="40dp"
			android:text="@string/explore_content_filter_all"
			android:textAllCaps="false" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_content_filter_sfw"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:minHeight="40dp"
			android:text="@string/explore_content_sfw"
			android:textAllCaps="false" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_content_filter_nsfw"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:minHeight="40dp"
			android:text="@string/explore_content_nsfw"
			android:textAllCaps="false" />

	</com.google.android.material.button.MaterialButtonToggleGroup>

	<!-- Preserve Local / Downloads / Migration and Suggestions, but place them after the primary
	     source controls so browsing starts with the compact selectors from the approved mockup. -->
	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/recyclerView_header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:clipChildren="false"
		android:clipToPadding="false"
		android:nestedScrollingEnabled="false"
		android:orientation="vertical"
		tools:listitem="@layout/item_explore_buttons" />

</org.koitharu.kotatsu.explore.ui.MiyorareExploreHeaderLayout>
