<?xml version="1.0" encoding="utf-8"?>
<!-- Explore uses the page RecyclerView as the single vertical scroll owner. The AppBar consumes
     nested scroll to move the header away, while ViewPager2 remains responsible only for horizontal
     Manga/Novel paging. This avoids the old NestedScrollView -> ViewPager2 -> RecyclerView handoff
     that could make vertical gestures feel delayed while preserving lazy/virtualized source rows. -->
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/scrollView"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:clipChildren="true">

	<androidx.coordinatorlayout.widget.CoordinatorLayout
		xmlns:app="http://schemas.android.com/apk/res-auto"
		android:id="@+id/layout_content"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipChildren="true"
		android:clipToPadding="true">

		<com.google.android.material.appbar.AppBarLayout
			android:id="@+id/explore_app_bar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@android:color/transparent"
			app:elevation="0dp"
			app:liftOnScroll="false">

			<include
				android:id="@+id/header"
				layout="@layout/layout_explore_header"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:layout_scrollFlags="scroll" />

		</com.google.android.material.appbar.AppBarLayout>

		<androidx.viewpager2.widget.ViewPager2
			android:id="@+id/pager"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			app:layout_behavior="@string/appbar_scrolling_view_behavior" />

	</androidx.coordinatorlayout.widget.CoordinatorLayout>

</FrameLayout>
