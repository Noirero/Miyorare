<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto">
	<ImageView
		android:id="@+id/imageView_personal_note"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:contentDescription="@string/chapter_personal_has_note"
		android:padding="15dp"
		app:srcCompat="@drawable/ic_export_notes" />
	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal">
		<TextView
			android:id="@+id/textView_personal_rating"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:importantForAccessibility="no"
			android:singleLine="true"
			android:textAppearance="?attr/textAppearanceBodySmall" />
		<ImageView
			android:id="@+id/imageView_personal_star"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:paddingStart="2dp"
			android:paddingTop="15dp"
			android:paddingEnd="28dp"
			android:paddingBottom="15dp"
			app:srcCompat="@drawable/ic_star_rate" />
	</LinearLayout>
</merge>
