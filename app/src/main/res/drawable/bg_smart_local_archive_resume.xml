<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item>
  <shape android:shape="rectangle">
   <gradient android:angle="0" android:startColor="#FFFFFF" android:centerColor="#FFFAF5" android:endColor="#F7F0E8"/>
   <corners android:radius="24dp"/>
   <stroke android:width="1dp" android:color="#CFC5BB"/>
  </shape>
 </item>
 <item android:gravity="right|top" android:width="140dp" android:height="130dp">
  <shape android:shape="oval">
   <gradient android:type="radial" android:gradientRadius="90dp" android:startColor="#30F0C28D" android:endColor="#00F0C28D"/>
  </shape>
 </item>
</layer-list>