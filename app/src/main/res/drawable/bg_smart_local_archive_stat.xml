<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item>
  <shape android:shape="rectangle">
   <gradient android:angle="90" android:startColor="#FFF8F0" android:endColor="#F4ECE3"/>
   <corners android:radius="18dp"/>
   <stroke android:width="1dp" android:color="#D2C5B8"/>
  </shape>
 </item>
 <item android:top="1dp" android:left="16dp" android:right="16dp" android:gravity="top">
  <shape android:shape="rectangle">
   <size android:height="1dp"/>
   <solid android:color="#64C69563"/>
  </shape>
 </item>
</layer-list>