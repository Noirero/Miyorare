<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item>
  <shape android:shape="rectangle">
   <gradient android:angle="135" android:startColor="#FFFFFF" android:centerColor="#FCF7F0" android:endColor="#F4EDE5"/>
   <corners android:radius="28dp"/>
   <stroke android:width="1dp" android:color="#D2C8BD"/>
  </shape>
 </item>
 <item android:gravity="top|right" android:width="220dp" android:height="200dp">
  <shape android:shape="oval">
   <gradient android:type="radial" android:gradientRadius="130dp" android:startColor="#3AF0C28D" android:centerColor="#16F0C28D" android:endColor="#00F0C28D"/>
  </shape>
 </item>
 <item android:gravity="bottom|left" android:width="230dp" android:height="150dp">
  <shape android:shape="oval">
   <gradient android:type="radial" android:gradientRadius="130dp" android:startColor="#24C4D9DD" android:endColor="#00C4D9DD"/>
  </shape>
 </item>
</layer-list>