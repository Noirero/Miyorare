<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item>
  <shape android:shape="rectangle">
   <gradient android:angle="135" android:startColor="#24394B" android:centerColor="#152535" android:endColor="#0C1624"/>
   <corners android:radius="28dp"/>
   <stroke android:width="1dp" android:color="#536577"/>
  </shape>
 </item>
 <item android:gravity="top|right" android:width="220dp" android:height="200dp">
  <shape android:shape="oval">
   <gradient android:type="radial" android:gradientRadius="130dp" android:startColor="#55E9AF70" android:centerColor="#1BDBA56D" android:endColor="#00DBA56D"/>
  </shape>
 </item>
 <item android:gravity="bottom|left" android:width="230dp" android:height="150dp">
  <shape android:shape="oval">
   <gradient android:type="radial" android:gradientRadius="130dp" android:startColor="#32426E81" android:endColor="#00426E81"/>
  </shape>
 </item>
</layer-list>